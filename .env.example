# ---------------------------------------------------------------------------
# PromiSure AI — environment configuration
# Copy to .env. Demo mode works with only DATABASE_URL set.
# ---------------------------------------------------------------------------

# Database (SQLite for local MVP; switch provider to postgresql for production)
DATABASE_URL="file:./dev.db"

# --- Shopify (optional — leave blank to use the demo store) ----------------
# Your store's myshopify domain
SHOPIFY_SHOP_DOMAIN=""
# Option A: Admin API access token from an existing admin-created custom app
SHOPIFY_ADMIN_ACCESS_TOKEN=""
# Option B: Dev Dashboard app installed on your own store (client credentials grant)
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# Admin GraphQL API version (latest stable at time of writing)
SHOPIFY_API_VERSION="2026-10"
# Webhook HMAC key. Shopify signs webhooks with the app's client secret;
# defaults to SHOPIFY_CLIENT_SECRET when blank.
SHOPIFY_WEBHOOK_SECRET=""
# Required scopes: read_products, read_inventory

# --- AI (optional — deterministic rules are used when not configured) ------
# rules | ollama | anthropic   (can also be changed in Settings)
AI_PROVIDER="rules"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
# Anthropic API key (separate from a Claude Pro subscription; API usage is billed)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# --- Monitoring -------------------------------------------------------------
# In-process scheduled polling interval (minutes). 0 disables it.
MONITOR_INTERVAL_MINUTES="15"
# Bearer token required by POST /api/monitor/run (for external cron). Blank = endpoint disabled.
CRON_SECRET=""
